{
  "name": "@railing-dev/adapter-radix",
  "version": "0.1.0",
  "description": "Reference adapter. Read this one first when writing a new adapter.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "build:playground": "vite build --base=./ --outDir=../../web/public/playground-mounts/radix --emptyOutDir",
    "preview": "vite preview --port 5180 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@railing-dev/harness-kit": "workspace:*",
    "@radix-ui/react-accordion": "catalog:subjects",
    "@radix-ui/react-dialog": "catalog:subjects",
    "@radix-ui/react-dropdown-menu": "catalog:subjects",
    "@radix-ui/react-tabs": "catalog:subjects",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
